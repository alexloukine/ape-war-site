{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/Build/(.*).wasm.unityweb",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Content-Encoding", "value": "br" }
      ]
    },
    {
      "source": "/Build/(.*).framework.js.unityweb",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Content-Encoding", "value": "br" }
      ]
    },
    {
      "source": "/Build/(.*).data.unityweb",
      "headers": [
        { "key": "Content-Encoding", "value": "br" }
      ]
    },
    {
      "source": "/Chimp War/Build/(.*).wasm.unityweb",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Content-Encoding", "value": "br" }
      ]
    },
    {
      "source": "/Chimp War/Build/(.*).framework.js.unityweb",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Content-Encoding", "value": "br" }
      ]
    },
    {
      "source": "/Chimp War/Build/(.*).symbols.json.unityweb",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Content-Encoding", "value": "br" }
      ]
    },
    {
      "source": "/StreamingAssets/aa/WebGL/(.*).bundle",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
